# Loaded automatically from the current working directory, or use --env-file PATH.
# Existing environment variables take precedence. No shell expansion is performed.
# Generate with: venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=
# Local development default; change after checking Traefik's actual watched directory.
TRAEFIK_CONFIG_DIR=./data/config
# Format for newly created routes: yaml -> {name}.yml, toml -> {name}.toml.
TRAEFIK_CONFIG_FORMAT=yaml
TRAEFIK_ENTRYPOINT=web
# Traefik API base URL (includes /api); not this service's :8000 address.
TRAEFIK_API_URL=http://127.0.0.1:8083/api
TRAEFIK_API_TIMEOUT_SECONDS=5
# Exact hostnames/IPs, or * to allow all upstream hosts and IPs.
ALLOWED_UPSTREAM_HOSTS=my-app
# CIDRs apply only to literal IP upstreams; * allows all IPv4/IPv6 addresses.
ALLOWED_UPSTREAM_CIDRS=172.19.0.0/16
PROBE_TIMEOUT_SECONDS=2
PROBE_ATTEMPTS=3
PROBE_INTERVAL_SECONDS=0.2
MAX_BODY_BYTES=16384
